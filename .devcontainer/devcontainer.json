{
  "name": "otlp2parquet",
  "image": "mcr.microsoft.com/devcontainers/rust:1-bookworm",
  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "onCreateCommand": "bash .devcontainer/setup.sh",
  "forwardPorts": [
    4318
  ],
  "portsAttributes": {
    "4318": {
      "label": "OTLP HTTP",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "vadimcn.vscode-lldb",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "rust-analyzer.check.command": "clippy",
        "editor.formatOnSave": true,
        "[rust]": {
          "editor.defaultFormatter": "rust-lang.rust-analyzer"
        }
      }
    }
  },
  "remoteUser": "vscode",
  "mounts": [
    "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind",
    "source=${localEnv:HOME}/.claude.json,target=/home/vscode/.claude.json,type=bind",
    "source=${localEnv:HOME}/.devcontainer-ca,target=/opt/host-ca,type=bind,readonly"
  ],
  "remoteEnv": {
    "DOCKER_HUB_MIRROR": "${localEnv:DOCKER_HUB_MIRROR}",
    "SMOKE_DOCKER_HOST": "host.docker.internal"
  },
  "initializeCommand": "mkdir -p \"$HOME/.devcontainer-ca\"",
  "containerEnv": {
    "NODE_EXTRA_CA_CERTS": "/etc/ssl/certs/ca-certificates.crt"
  }
}
